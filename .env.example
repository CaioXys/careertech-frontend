# Copie para .env se quiser mudar algo (o .env não vai para o git).

# true  = usa dados falsos (src/mocks). Ideal enquanto não existe back-end.
# false = chama a API real em VITE_API_URL.
VITE_USE_MOCKS=true

# Endereço do back-end (repositório separado), usado quando VITE_USE_MOCKS=false.
VITE_API_URL=http://localhost:3000
